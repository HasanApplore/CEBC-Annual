PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cebc?appName=CEBC
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated, no trailing slash — must include every origin that calls this API.
# This is also literally what the Jenkins backend pipeline's ENV_FILE_CONTENT
# must contain — that pipeline is the actual source of truth for the live env.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://cebc.applore.in,https://cebc-admin.applore.in

SEED_ADMIN_NAME=CEBC Admin
SEED_ADMIN_EMAIL=admin@cebcmena.com
SEED_ADMIN_PASSWORD=change-this-password

# AWS S3
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
